# Copy to .env (which is gitignored) and fill in on YOUR machine only.
# Never commit real values.

# Instructor key that unseals challenges/solutions.enc. No default: unset => the
# app runs normally and solutions cannot be read from source.
LLMVAULT_SOLUTION_KEY=

# Optional: private pepper for a scored/private instance so flags aren't
# recoverable from the public source. If set, run: python -m tools.sealtool reseal-flags
# and keep this exported at runtime.
# LLMVAULT_PEPPER=
